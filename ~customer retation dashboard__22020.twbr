      <aliases enabled='yes' />
      <column aggregation='None' datatype='integer' name='[Average Rating (bin)]' role='dimension' type='quantitative'>
        <calculation class='bin' decimals='-1' formula='[Average Rating]' peg='0' size='0.22' />
      </column>
      <column datatype='real' name='[Average Rating]' role='measure' type='quantitative' />
      <column caption='Engagement Score' datatype='real' name='[Calculation_1483373195330781184]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Items Purchased] * [Average Rating]' />
      </column>
      <column caption='Sentiment' datatype='string' name='[Calculation_1483373195359395841]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Satisfaction Level] = &quot;Satisfied&quot; THEN &quot;Positive&quot;&#13;&#10;ELSEIF [Satisfaction Level] = &quot;Neutral&quot; THEN &quot;Neutral&quot;&#13;&#10;ELSE &quot;Negative&quot;&#13;&#10;END' />
      </column>
      <column caption='Emotion' datatype='string' name='[Calculation_1483373195363430402]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Average Rating] &gt;= 4 THEN &quot;Happy&quot;&#13;&#10;ELSEIF [Average Rating] &gt;= 3 THEN &quot;Neutral&quot;&#13;&#10;ELSE &quot;Frustrated&quot;&#13;&#10;END' />
      </column>
      <column caption='Churn Risk' datatype='string' name='[Calculation_978407086757232640]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Days Since Last Purchase] &lt;= 30 THEN &quot;Low&quot;&#13;&#10;ELSEIF [Days Since Last Purchase] &lt;= 60 THEN &quot;Medium&quot;&#13;&#10;ELSE &quot;High&quot;&#13;&#10;END' />
      </column>
      <column caption='Repeat Buyer' datatype='string' name='[Calculation_978407086757466113]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Items Purchased] &gt; 10 THEN &quot;Yes&quot;&#13;&#10;ELSE &quot;No&quot;&#13;&#10;END' />
      </column>
      <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
      <column datatype='integer' name='[Customer ID]' role='dimension' type='ordinal' />
      <column aggregation='None' datatype='integer' name='[Days Since Last Purchase (bin)]' role='dimension' type='quantitative'>
        <calculation class='bin' decimals='0' formula='[Days Since Last Purchase]' peg='0' size='4.16' />
      </column>
      <column datatype='integer' name='[Days Since Last Purchase]' role='measure' type='quantitative' />
      <column datatype='string' name='[Membership Type]' role='dimension' type='nominal' />
